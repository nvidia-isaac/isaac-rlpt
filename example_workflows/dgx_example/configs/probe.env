# The throughput probe: the settings every layout and card ran with. Sourced by the scripts.
PROBE_TASK=DrillLift
# Environment steps collected per environment; the run's budget is max(PROBE_ENV_STEPS_PER_ENV * N, PROBE_MIN_ENV_STEPS).
# The batched worker collects one whole epoch per iteration (every environment plays one episode of up to
# 450 steps), and the collection rate is logged once per iteration, so the budget spans three full-length
# epochs: the first iteration carries the initial reset and is dropped, the rest give the mean and spread.
PROBE_ENV_STEPS_PER_ENV=1350
PROBE_MIN_ENV_STEPS=6400
# SAC updates per collection cycle, capped so the learner's share of each cycle stays bounded at every N.
PROBE_MAX_UPDATES_PER_BURST=20
# Frames leave the simulator shrunk to the policy processor's input edge (native is 480x640).
PROBE_IMAGE_SHORTEST_EDGE=256
# The frozen policy decodes all N environments in one forward (simulator.decode_batch_size=N); 0 keeps
# the simulator entry's own cap, which bounds the decode's memory on a small card.
PROBE_DECODE_WHOLE_BATCH=1
# No evaluation simulator during a probe: it would take a card's memory and time without measuring anything.
PROBE_EVAL_SIM=0
# The training simulator's port; the split's learner connects to it over loopback.
PROBE_PORT=7300
# The learner's rollout runtime: native keeps the rollout worker (simulator client, frozen policy,
# actor sampling) inside the learner process; rlinf places it as a Ray actor through the RLinf
# runtime (docs/runtimes.md), in the launcher's rlinf image. RUNTIME=rlinf in the environment of a
# script overrides this default; runs then carry the runtime in their names (probe_<layout>_rlinf_n<N>).
PROBE_RUNTIME=native
# The learner's schedule (schedule.kind): sync collects a round, trains on it, then publishes; overlapped
# starts the next round before the training burst, so the burst runs while the workers collect on the
# weights of the previous publish. SCHEDULE=overlapped in the environment of a script overrides this
# default; runs then carry the schedule in their names (probe_<layout>[_rlinf]_overlapped_n<N>).
# The gain shows only when a burst takes about as long as a round: MAX_UPDATES_PER_BURST sizes it.
PROBE_SCHEDULE=sync
